{
  "name": "@cavehunt/server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc --noEmit && esbuild src/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.mjs"
  },
  "dependencies": {
    "@colyseus/core": "0.18.16",
    "@colyseus/schema": "5.0.35",
    "@colyseus/ws-transport": "0.18.3",
    "express": "^5.2.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@colyseus/sdk": "0.18.4",
    "esbuild": "^0.25.0"
  }
}
